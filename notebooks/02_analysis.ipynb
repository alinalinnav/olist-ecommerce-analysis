    "import sqlite3\n",
    "import pandas as pd \n",
    "\n",
    "conn = sqlite3.connect(\"../data/olist.db\")\n",
    "\n",
    "def q(sql):\n",
    "    return pd.read_sql(sql, conn)\n",
    "\n",
    "q(\"\"\"\n",
    "SELECT COUNT(*) AS orders,\n",
    "COUNT (DISTINCT customer_id) AS customers\n",
    "FROM orders\n",
    "\"\"\")"
   ]
  }
